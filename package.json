{
  "name": "opencode-plugin-cc",
  "version": "1.0.1",
  "description": "Delegate code review and coding tasks to the opencode CLI from Claude Code.",
  "license": "MIT",
  "author": "rivaldofwijaya",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rivaldofwijaya/opencode-plugin-cc.git"
  },
  "homepage": "https://github.com/rivaldofwijaya/opencode-plugin-cc#readme",
  "bugs": "https://github.com/rivaldofwijaya/opencode-plugin-cc/issues",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "test": "node --test 'dev/tests/unit/**/*.test.mjs' 'dev/tests/integration/**/*.test.mjs' dev/tests/lint-commands.test.mjs",
    "test:isolated": "node --test 'dev/tests/isolated/**/*.test.mjs'",
    "test:live": "OPENCODE_LIVE=1 node --test --test-concurrency=1 'dev/tests/live/**/*.test.mjs'"
  }
}
