{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/src/session-lifecycle-hook.mjs\" SessionStart",
            "timeout": 1.5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/src/session-lifecycle-hook.mjs\" SessionEnd",
            "timeout": 1.5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/src/stop-review-gate-hook.mjs\"",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
